+uint64
+count_used_procs(void)
+{
+  struct proc *p;
+  uint64 count = 0;
+  
+  for(p = proc; p < &proc[NPROC]; p++){
+    acquire(&p->lock);
+    if(p->state != UNUSED) { // Nếu trạng thái khác UNUSED thì đếm
+      count++;
+    }
+    release(&p->lock);
+  }
+  return count;
+}
