diff --git a/kernel/kalloc.c b/kernel/kalloc.c
index 0699e7e..8a8b7c1 100644
--- a/kernel/kalloc.c
+++ b/kernel/kalloc.c
@@ -80,3 +80,20 @@ kalloc(void)
     memset((char*)r, 5, PGSIZE); // fill with junk
   return (void*)r;
 }
+
+uint64
+count_free_mem(void)
+{
+  struct run *r;
+  uint64 count = 0;
+  
+  acquire(&kmem.lock);
+  r = kmem.freelist;
+  while(r){
+    count += PGSIZE;
+    r = r->next;
+  }
+  release(&kmem.lock);
+  
+  return count;
+}
